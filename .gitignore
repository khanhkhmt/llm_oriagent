# =========================================================================
# SYSTEM & SECURITY / CONFIGURATION KEYS (CRITICAL SECTIONS)
# =========================================================================

# Environment variable files and local secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
.env.bak
*.env
*.env.local

# Allow env.example files as templates
!.env.example
!web/.env.example
!.env.example.*

# PM2 and other deployment configurations containing production credentials
ecosystem.config.js
ecosystem.config.cjs
ecosystem.config.json

# Shell scripts (contains deployment/setup credentials)
*.sh

# SSL Certificates, Private Keys, and SSH directories
*.pem
*.key
*.pub
*.cert
*.crt
*.p12
*.pfx
.ssh/
secrets/
credentials/
config/keys.json
keys/
jwt_secret*

# Databases, WAL locks, and local SQLite data
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db-journal

# Nginx config backups (may contain domain and internal routing IPs)
*nginx*.bak
*nginx*.tmp

# Operating System & IDE Files
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

